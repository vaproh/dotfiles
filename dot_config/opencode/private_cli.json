{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "matugen",
    "mode": "dark"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "tabs": {
    "mode": "auto"
  }
}
