{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0",
    "@dietrichgebert/ponytail@5.3.2",
    "opencode-skills-collection@4.1.18",
    "@maestria/opencode@0.11.0",
    {
      "package": "@knikolov/opencode-plugin-simple-memory@2.0.0",
      "options": {
        "autoLoad": true,
        "autoSave": true,
        "contextLimit": 3,
        "contextMaxChars": 800,
      },
    },
  ],
  "update": "disable",
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      ".venv/**",
      "__pycache__/**",
      ".svelte-kit/**",
    ],
  },
  "compaction": {
    "buffer": 20000,
  },
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 25000,
  },
  "agents": {
    "explore": {
      "permissions": [
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny",
        },
      ],
    },
    "orchestrator": {
      "color": "#FFB020",
      "permissions": [
        {
          "action": "context7_*",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "exa_*",
          "resource": "*",
          "effect": "allow",
        },
        {
          "action": "playwright_*",
          "resource": "*",
          "effect": "deny",
        },
      ],
    },
  },
  "lsp": {
    "basedpyright": {
      "command": [
        "basedpyright-langserver",
        "--stdio"
      ],
      "extensions": [
        ".py"
      ],
      "priority": 100,
    },
    "ruff": {
      "command": [
        "ruff",
        "server"
      ],
      "extensions": [
        ".py"
      ],
      "priority": 90,
    },
    "pyright": {
      "disabled": true,
    },
  },
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7-API-KEY": "{env:CONTEXT7_API_KEY}",
        },
        "disabled": false,
      },
      "exa": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "exa-mcp-server"
        ],
        "environment": {
          "EXA_API_KEY": "{env:EXA_API_KEY}",
        },
        "disabled": false,
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest"
        ],
        "disabled": false,
      },
      "github": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "environment": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}",
        },
        "disabled": false,
      },
      // "blender": {
      //   "type": "local",
      //   "command": ["uvx", "blender-mcp"],
      //   "disabled": false
      // },
      //
      // "godot": {
      //   "type": "local",
      //   "command": ["npx", "-y", "godot-mcp-runtime"],
      //   "env": {
      //     "GODOT_PATH": "/usr/bin/godot"
      //   },
      //   "disabled": false
      // },
    },
  },
}
