binds {
    // ── Launcher & session ──
    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma { spawn-sh "noctalia msg settings-toggle"; }
    Alt+Tab { spawn-sh "noctalia msg window-switcher"; }
    Mod+P { spawn-sh "noctalia msg session-toggle"; }
    Mod+Shift+D { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Mod+Shift+A { spawn-sh "~/.config/niri/categories/floating-workspace.sh"; }

    // ── Terminal & apps ──
    Mod+Return { spawn "kitty"; }
    Mod+E { spawn "dolphin"; }
    Mod+D { spawn "kitty" "-e" "--title" "floating_yazi" "zsh" "-i" "-c" "y; zsh -i"; }

    // ── Window management ──
    Mod+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+Space { toggle-window-floating; }
    Mod+C { center-column; }

    // ── Focus (vim) ──
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    // ── Focus (arrows) ──
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }

    // ── Move windows (vim) ──
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    // ── Move windows (arrows) ──
    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }

    // ── Resize (vim) ──
    Mod+Shift+H { set-column-width "-10%"; }
    Mod+Shift+L { set-column-width "+10%"; }
    Mod+Shift+J { set-window-height "-10%"; }
    Mod+Shift+K { set-window-height "+10%"; }

    // ── Resize (arrows) ──
    Mod+Shift+Left { set-column-width "-10%"; }
    Mod+Shift+Right { set-column-width "+10%"; }
    Mod+Shift+Down { set-window-height "-10%"; }
    Mod+Shift+Up { set-window-height "+10%"; }

    // ── Workspaces ──
    Mod+1 { focus-workspace "ter"; }
    Mod+2 { focus-workspace "cod"; }
    Mod+3 { focus-workspace "www"; }
    Mod+4 { focus-workspace "sof"; }
    Mod+5 { focus-workspace "util"; }
    Mod+6 { focus-workspace "vid"; }
    Mod+7 { focus-workspace "mus"; }
    Mod+8 { focus-workspace "chat"; }
    Mod+9 { focus-workspace "soc"; }
    Mod+0 { focus-workspace "idk"; }

    Mod+Shift+1 { move-column-to-workspace "ter"; }
    Mod+Shift+2 { move-column-to-workspace "cod"; }
    Mod+Shift+3 { move-column-to-workspace "www"; }
    Mod+Shift+4 { move-column-to-workspace "sof"; }
    Mod+Shift+5 { move-column-to-workspace "util"; }
    Mod+Shift+6 { move-column-to-workspace "vid"; }
    Mod+Shift+7 { move-column-to-workspace "mus"; }
    Mod+Shift+8 { move-column-to-workspace "chat"; }
    Mod+Shift+9 { move-column-to-workspace "soc"; }
    Mod+Shift+0 { move-column-to-workspace "idk"; }

    // ── Overview ──
    Mod+Tab { toggle-overview; }

    // ── Screenshots ──
    Mod+Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // ── Screen toolkit, cheatsheet, gaming, bar ──
    Mod+Shift+Z { spawn-sh "noctalia msg plugin alexander/screen-toolkit:service all toggle"; }
    Mod+F1 { spawn-sh "noctalia msg panel-toggle kenn/keybind-cheatsheet:cheatsheet"; }
    Mod+Shift+F1 { spawn-sh "~/.config/niri/categories/gaming.sh"; }
    Mod+B { spawn-sh "noctalia msg bar-toggle"; }

    // ── Opacity ──
    Mod+Backslash { toggle-window-rule-opacity; }

    // ── Clipboard ──
    Mod+V { spawn-sh "copyq toggle"; }

    // ── Notifications DND ──
    Mod+Alt+Z { spawn-sh "noctalia msg notification-dnd-toggle"; }

    // ── Media keys ──
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    

    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }

    // ── Mouse binds ──
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
}
