layout {
    gaps 6
    center-focused-column "never"

    default-column-width { proportion 0.55; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring { off; }

    border {
        on
        width 2
        active-color "#21222c"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }

    shadow {
        on
        softness 20
        spread 4
        offset x=0 y=4
        draw-behind-window true
        color "#1a1a1aee"
    }
}

window-rule {
    geometry-corner-radius 2
    clip-to-geometry true
}

blur {
    passes 2
    offset 3.0
    noise 0.02
    saturation 1.0
}

window-rule {
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

animations {
    window-open {
        duration-ms 150
        curve "cubic-bezier" 0.05 0.7 0.1 1
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    workspace-switch {
        spring damping-ratio=1.0 stiffness=1000 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
}

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}
