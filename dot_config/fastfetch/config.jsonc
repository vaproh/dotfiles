{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "#63a2be",
      "2": "#b263bb"
    }
  },
  "display": {
    "separator": " ┆ ",
    "color": {
      "keys": "#81a2be",
      "title": "#b294bb"
    },
    "percent": {
      "color": {
        "green": "#de935f",
        "yellow": "#96c3e9",
        "red": "#cc6666"
      }
    }
  },
  "modules": [
    {
      "type": "title"
    },
    {
      "type": "custom",
      "format": "────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇"
    },
    {
      "type": "kernel",
      "key": "󰒋"
    },
    {
      "type": "wm",
      "key": ""
    },
    {
      "type": "shell",
      "key": ""
    },
    {
      "type": "terminal",
      "key": ""
    },
    {
      "type": "packages",
      "key": "󰏖"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "cpu",
      "key": "󰍛"
    },
    {
      "type": "gpu",
      "key": "󰢮"
    },
    {
      "type": "memory",
      "key": "󰘚"
    },
    {
      "type": "disk",
      "key": "󰋊"
    },
    {
      "type": "uptime",
      "key": "󱫐"
    },
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "colors",
      "paddingLeft": 2
    }
  ]
}
